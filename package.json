{
  "name": "rgd-bot",
  "version": "1.0.0",
  "license": "ISC",
  "author": "RGD Community",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Russian-Gamedev/rgd-bot.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Russian-Gamedev/rgd-bot#issues"
  },
  "homepage": "https://github.com/Russian-Gamedev/rgd-bot#readme",
  "scripts": {
    "prepare": "bun ./.github/hooks/setup-git-hooks.sh",
    "start:dev": "bun --env-file .env.development --watch ./src/main.ts",
    "build": "bun run build.ts",
    "compose:dev": "docker compose -f ./docker/docker-compose.dev.yml up",
    "compose:prod": "docker compose -f ./docker/docker-compose.yml up",
    "migration:create": "bunx --bun mikro-orm migration:create",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun biome ci",
    "lint:fix": "bunx --bun biome check --write",
    "check:all": "bun run typecheck && bun run lint && bun test"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@mikro-orm/cli": "^7.2.0",
    "@nestjs/cli": "^12.0.0",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@necord/pagination": "^3.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord.js": "^14.27.0",
    "ioredis": "^6.0.0",
    "necord": "npm:@damirlut/necord@^7.0.0",
    "openai": "^7.10.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "necord"
  ]
}
