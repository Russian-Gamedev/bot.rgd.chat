NODE_ENV=development

PORT = 3000

BASE_URL=

POSTGRES_URL=
REDIS_URL=

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Optional: Discord channel for startup notifications
DEBUG_CHANNEL_ID=
DISCORD_DEVELOPMENT_GUILD_ID=

JWT_SECRET=<random secret>

CORS_ORIGINS=

AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_NAME=rgd_access_token

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ROOT=https://api.telegram.org

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_TOKEN=<random metrics token>

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ACCESS_TOKEN=

# S3 STORAGE CONFIGURATION (S3-compatible: MinIO, Yandex Object Storage, AWS S3, ...)
# For direct browser uploads the bucket must also allow CORS from the frontend origins
# (configured on the storage provider side in production; handled by MinIO defaults in dev).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=golder
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing (required for MinIO, optional for AWS S3)
S3_FORCE_PATH_STYLE=true
# Optional: public base URL for read links (e.g. CDN or bucket website domain).
# Derived from S3_ENDPOINT + S3_BUCKET when not set.
S3_PUBLIC_BASE_URL=

# Optional: frontend site origin used for links back to the site (golder pages).
WEB_BASE_URL=https://rgd.chat

# DATABASE CONFIGURATION

POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_DB=bot-rgd-chat
